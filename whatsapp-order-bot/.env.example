# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-here
WHATSAPP_ACCESS_TOKEN=your-permanent-or-temporary-access-token
PORT=3000

# Google Sheets
SPREADSHEET_ID=your-google-sheet-id
SHEET_NAME=Orders
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Optional: set this to auto-extract customer name / product / quantity / area
# from the free-text message using Claude. Leave empty to just log raw text.
ANTHROPIC_API_KEY=
